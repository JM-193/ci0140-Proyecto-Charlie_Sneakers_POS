<?xml version="1.0" encoding="utf-8" ?>
<!--
  Alcance de la medición de cobertura (M5.3, meta Fase 3: >= 90 % de líneas).
  Se mide la lógica de negocio (namespace Backend.Api.Services).
  Cada exclusión debe declararse y justificarse en el informe.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>opencover,cobertura</Format>
          <Include>[Backend.Api]Backend.Api.Services.*</Include>
          <!--
            Fuera del alcance de los casos de uso "Registrar venta" y "Cerrar y cuadrar caja":
            autenticación y hashing de contraseñas. Ajustar esta lista cuando el equipo
            cierre el alcance definitivo.
          -->
          <Exclude>[Backend.Api]Backend.Api.Services.AuthService,[Backend.Api]Backend.Api.Services.PasswordService</Exclude>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
